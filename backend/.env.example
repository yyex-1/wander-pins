# 复制本文件为 backend/.env 后填入真实值。
# backend/.env 已被 .gitignore 忽略，禁止提交。

# Supabase 控制台 -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co

# 仅服务端使用。会绕过 RLS，等同数据库 root 权限。
# 绝不能出现在前端代码、截图、日志或仓库里。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT 签名密钥，生成方式：openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-32-byte-hex

JWT_ALGORITHM=HS256

# 允许跨域的前端地址
FRONTEND_ORIGIN=http://127.0.0.1:8138
